/* ===== 兼容旧变量 ===== */
page {
  background-color: #FFFCF8;
  font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  font-size: 28rpx;
  color: #1A1410;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}
view, text, image, scroll-view, swiper {
  box-sizing: border-box;
}
.price {
  color: #1A1410;
  font-weight: 900;
  font-size: 36rpx;
}
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 主按钮 */
.btn-primary {
  background: #B10A0F;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-weight: 600;
  text-align: center;
  transition: background 0.15s ease;
}
.btn-primary:active {
  background: #7A070A;
}
.btn-primary--disabled {
  background: #CCCCCC !important;
  color: #FFFFFF;
}

/* 次按钮 */
.btn-secondary {
  background: #FFFFFF;
  color: #7F7368;
  border: 1rpx solid #E8DDD4;
  border-radius: 999rpx;
  font-weight: 500;
  text-align: center;
}
.btn-secondary:active {
  background: #F5F0EA;
}
.page-tabbar-spacer {
  height: calc(108rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.app-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  width: 100%;
  height: calc(108rpx + env(safe-area-inset-bottom));
  min-height: 100rpx;
  padding: 8rpx 16rpx env(safe-area-inset-bottom);
  display: flex;
  background: #FFFCF8;
  border-top: 1rpx solid #E8DDD4;
  box-sizing: border-box;
}
.app-tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 88rpx;
}
.app-tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
}
.app-tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.app-tab-text {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}