.order-page.data-v-1f245baa {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
  /* ===== Header ===== */
  /* Hanging sign toggle */
  /* ===== Loading / Empty ===== */
  /* ===== Main content ===== */
}
.order-page__header.data-v-1f245baa {
  flex-shrink: 0;
  padding: 0 32rpx 28rpx;
  background: linear-gradient(135deg, #C41E3A 0%, #E8364E 60%, #F05A6E 100%);
  position: relative;
  overflow: visible;
}
.order-page__brand-row.data-v-1f245baa {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order-page__logo.data-v-1f245baa {
  width: 160rpx;
  height: 64rpx;
}
.order-page__mascot.data-v-1f245baa {
  width: 72rpx;
  height: 72rpx;
}
.order-page__slogan.data-v-1f245baa {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  opacity: 0.9;
  letter-spacing: 4rpx;
}
.order-page__store-status.data-v-1f245baa {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.order-page__store-status-text.data-v-1f245baa {
  font-size: 22rpx;
  color: #FFFFFF;
  opacity: 0.85;
}
.order-page__store-hours.data-v-1f245baa {
  font-size: 22rpx;
  color: #FFFFFF;
  opacity: 0.7;
}
.order-page__mode-sign.data-v-1f245baa {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}
.order-page__mode-sign-rope.data-v-1f245baa {
  width: 4rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.5);
}
.order-page__mode-sign-board.data-v-1f245baa {
  display: flex;
  align-items: center;
  background: #FFD978;
  border-radius: 12rpx;
  padding: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  position: relative;
}
.order-page__mode-sign-board.data-v-1f245baa::before, .order-page__mode-sign-board.data-v-1f245baa::after {
  content: "";
  position: absolute;
  top: -12rpx;
  width: 4rpx;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.5);
}
.order-page__mode-sign-board.data-v-1f245baa::before {
  left: 40rpx;
}
.order-page__mode-sign-board.data-v-1f245baa::after {
  right: 40rpx;
}
.order-page__mode-tab.data-v-1f245baa {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 56rpx;
  border-radius: 8rpx;
  transition: background 0.15s ease;
}
.order-page__mode-tab--active.data-v-1f245baa {
  background: #D00000;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.order-page__mode-tab--disabled.data-v-1f245baa {
  opacity: 0.45;
}
.order-page__mode-tab-text.data-v-1f245baa {
  font-size: 26rpx;
  font-weight: 700;
  color: #111111;
}
.order-page__mode-tab--active .order-page__mode-tab-text.data-v-1f245baa {
  color: #FFFFFF;
}
.order-page__loading.data-v-1f245baa, .order-page__empty.data-v-1f245baa {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  padding: 0 48rpx;
  text-align: center;
  line-height: 1.6;
  font-size: 26rpx;
}
.order-page__main.data-v-1f245baa {
  flex: 1;
  display: flex;
  overflow: hidden;
  min-height: 0;
}
.order-page__dishes.data-v-1f245baa {
  flex: 1;
  height: 100%;
  background: #FFFFFF;
  padding: 24rpx;
  box-sizing: border-box;
}
.order-page__section-title.data-v-1f245baa {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #111111;
  margin-bottom: 24rpx;
}
.order-page__dish-list.data-v-1f245baa {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.order-page__dish-empty.data-v-1f245baa {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #999999;
  font-size: 26rpx;
}
.order-page__dish-bottom-space.data-v-1f245baa {
  height: calc(140rpx + calc(108rpx + env(safe-area-inset-bottom)));
}

/* ===== Menu Card ===== */
.menu-card.data-v-1f245baa {
  display: flex;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #EEEEEE;
}
.menu-card__image.data-v-1f245baa {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
}
.menu-card__info.data-v-1f245baa {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 176rpx;
  overflow: hidden;
}
.menu-card__name.data-v-1f245baa {
  font-size: 26rpx;
  font-weight: 900;
  color: #111111;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.menu-card__tags.data-v-1f245baa {
  margin-top: 8rpx;
}
.menu-card__tag.data-v-1f245baa {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #D00000;
  border: 1rpx solid #D00000;
  border-radius: 999rpx;
  background: rgba(208, 0, 0, 0.06);
}
.menu-card__sales.data-v-1f245baa {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}
.menu-card__bottom.data-v-1f245baa {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.menu-card__price.data-v-1f245baa {
  color: #D00000;
  font-size: 34rpx;
  font-weight: 900;
}
.menu-card__actions.data-v-1f245baa {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.menu-card__btn.data-v-1f245baa {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 1rpx solid #EEEEEE;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}
.menu-card__btn--minus.data-v-1f245baa {
  border-color: #999999;
}
.menu-card__btn-icon.data-v-1f245baa {
  color: #666666;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}
.menu-card__count.data-v-1f245baa {
  min-width: 36rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #111111;
}
.menu-card__spec-btn.data-v-1f245baa {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 20rpx;
  border: 2rpx solid #D00000;
  border-radius: 999rpx;
  background: rgba(208, 0, 0, 0.04);
}
.menu-card__spec-btn--disabled.data-v-1f245baa {
  opacity: 0.5;
}
.menu-card__spec-btn-text.data-v-1f245baa {
  font-size: 22rpx;
  font-weight: 700;
  color: #D00000;
}

/* ===== Cart Bar ===== */
.cart-bar.data-v-1f245baa {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(calc(108rpx + env(safe-area-inset-bottom)) + 12rpx);
  z-index: 99;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx 12rpx 12rpx;
  background: #111111;
  border-radius: 999rpx;
  box-shadow: 0 48rpx 120rpx -60rpx rgba(208, 0, 0, 0.32);
}
.cart-bar--disabled.data-v-1f245baa {
  opacity: 0.75;
}
.cart-bar__avatar-wrap.data-v-1f245baa {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}
.cart-bar__avatar.data-v-1f245baa {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.cart-bar__badge.data-v-1f245baa {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #D00000;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border: 3rpx solid #111111;
}
.cart-bar__badge-text.data-v-1f245baa {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
}
.cart-bar__price.data-v-1f245baa {
  flex: 1;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 900;
}
.cart-bar__btn.data-v-1f245baa {
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 48rpx;
  background: #D00000;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-bar__btn--disabled.data-v-1f245baa {
  background: #666666;
}
.cart-bar__btn-text.data-v-1f245baa {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
}

/* ===== Bottom TabBar ===== */
.app-tab-bar.data-v-1f245baa {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}
.app-tab-item.data-v-1f245baa {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 4rpx;
}
.app-tab-item--active .app-tab-text.data-v-1f245baa {
  font-weight: 700;
}
.app-tab-icon-wrap.data-v-1f245baa {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.app-tab-icon.data-v-1f245baa {
  width: 44rpx;
  height: 44rpx;
}
.app-tab-icon--inactive.data-v-1f245baa {
  filter: grayscale(1) opacity(0.45);
}
.app-tab-text.data-v-1f245baa {
  font-size: 20rpx;
  line-height: 1.2;
}