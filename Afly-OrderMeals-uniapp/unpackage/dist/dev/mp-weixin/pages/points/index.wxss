  height: 0;
}
.points-page__hero.data-v-dd6e20da {
  background: linear-gradient(180deg, #FFD4D4 0%, #FF7984 100%);
  position: relative;
  overflow: hidden;
}
.points-page__hero-content.data-v-dd6e20da {
  padding: 26rpx 24rpx 34rpx;
  position: relative;
}
.points-page__points-row.data-v-dd6e20da {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.points-page__points-info.data-v-dd6e20da {
  display: flex;
  flex-direction: column;
}
.points-page__points-value.data-v-dd6e20da {
