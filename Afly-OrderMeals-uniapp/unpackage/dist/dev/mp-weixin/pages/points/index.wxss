  color: rgba(255, 255, 255, 0.85);
}
.points-page__promo-watermark.data-v-dd6e20da {
  position: absolute;
  right: 12rpx;
  bottom: -28rpx;
  font-size: 132rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.42);
  font-weight: 900;
}
.points-page__category-bar.data-v-dd6e20da {
  padding: 24rpx 24rpx 0;
}
.points-page__category-scroll.data-v-dd6e20da {
  white-space: nowrap;
}
.points-page__category-list.data-v-dd6e20da {
  display: inline-flex;
  gap: 8rpx;
}
.points-page__category-item.data-v-dd6e20da {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
