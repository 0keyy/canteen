  font-weight: 700;
}
.points-page__category-item--active.data-v-dd6e20da::after {
  content: "";
  position: absolute;
  left: 26rpx;
  right: 26rpx;
  bottom: 4rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #C41E3A;
}
.points-page__category-text.data-v-dd6e20da {
  font-size: 26rpx;
  color: #7F7368;
  font-weight: 500;
  white-space: nowrap;
}
.points-page__product-grid.data-v-dd6e20da {
  display: grid;
