  color: #FFFFFF;
  font-weight: 600;
}
.points-page__product-info.data-v-dd6e20da {
  padding: 16rpx 20rpx 20rpx;
}
.points-page__product-title.data-v-dd6e20da {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1410;
