}
.points-page__product-image-wrap.data-v-dd6e20da {
  position: relative;
  width: 100%;
  height: 230rpx;
}
.points-page__product-image.data-v-dd6e20da {
  width: 100%;
  height: 230rpx;
  background: #F5F0EA;
}
.points-page__product-badge.data-v-dd6e20da {
  position: absolute;
  top: 0;
  left: 0;
  background: #C41E3A;
