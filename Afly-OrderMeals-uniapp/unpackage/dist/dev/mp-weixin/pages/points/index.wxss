  gap: 20rpx;
  padding: 18rpx 24rpx 0;
}
.points-page__product-card.data-v-dd6e20da {
  background: #FFFFFF;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: none;
}
.points-page__product-card.data-v-dd6e20da:active {
