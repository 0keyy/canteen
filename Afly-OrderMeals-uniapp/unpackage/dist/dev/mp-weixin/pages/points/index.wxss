}
.points-page__product-points-num.data-v-dd6e20da {
  font-size: 34rpx;
  font-weight: 900;
  color: #C41E3A;
  line-height: 1;
}
.points-page__product-points-unit.data-v-dd6e20da {
  font-size: 22rpx;
  color: #C41E3A;
  font-weight: 600;
  margin-left: 4rpx;
}
.points-page__product-redeemed.data-v-dd6e20da {
