}
.points-page__bottom-space.data-v-dd6e20da {
  height: calc(108rpx + env(safe-area-inset-bottom));
}

/* ===== 底部 TabBar ===== */
.app-tab-bar.data-v-dd6e20da {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  width: 100%;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding: 8rpx 16rpx env(safe-area-inset-bottom);
  display: flex;
  background: rgba(255, 252, 248, 0.98);
  border-top: 1rpx solid #E8DDD4;
  box-sizing: border-box;
  -webkit-backdrop-filter: blur(8px);
          backdrop-filter: blur(8px);
}
.app-tab-item.data-v-dd6e20da {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 88rpx;
  border-radius: 32rpx;
}
.app-tab-icon-wrap.data-v-dd6e20da {
