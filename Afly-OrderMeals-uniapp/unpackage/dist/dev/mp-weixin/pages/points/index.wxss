  color: #5a5a5a;
  line-height: 1.4;
}
.points-page__mascot.data-v-dd6e20da {
  width: 178rpx;
  height: 178rpx;
  flex-shrink: 0;
}
.points-page__scan-btn.data-v-dd6e20da {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.points-page__scan-icon.data-v-dd6e20da {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 8rpx;
  position: relative;
}
.points-page__scan-icon.data-v-dd6e20da::before, .points-page__scan-icon.data-v-dd6e20da::after {
  content: "";
  position: absolute;
  background: #FFFFFF;
}
.points-page__scan-icon.data-v-dd6e20da::before {
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
}
.points-page__scan-icon.data-v-dd6e20da::after {
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 16rpx;
  height: 4rpx;
}
.points-page__nav-tabs.data-v-dd6e20da {
  display: flex;
  background: #FFFFFF;
  padding: 0 16rpx;
  box-shadow: none;
}
.points-page__nav-tab.data-v-dd6e20da {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  position: relative;
}
.points-page__nav-tab--active .points-page__nav-tab-text.data-v-dd6e20da {
  color: #C41E3A;
  font-weight: 700;
}
.points-page__nav-tab--active.data-v-dd6e20da::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #C41E3A;
}
.points-page__nav-tab-text.data-v-dd6e20da {
  font-size: 26rpx;
  color: #7F7368;
  font-weight: 500;
}
.points-page__promo-row.data-v-dd6e20da {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 24rpx 0;
}
.points-page__promo-card.data-v-dd6e20da {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #FF4F59 0%, #FFB5A8 100%);
}
.points-page__promo-main.data-v-dd6e20da {
