.company-auth-page.data-v-431fd8fd {
  min-height: 100vh;
  background: #FFFCF8;
  padding: 24rpx 24rpx 140rpx;
}
.company-auth-page--verified.data-v-431fd8fd {
  padding-bottom: 24rpx;
}
.company-auth-page__card.data-v-431fd8fd {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 58, 0.08);
}
.company-auth-page__card--success.data-v-431fd8fd {
  text-align: center;
  padding-top: 48rpx;
}
.company-auth-page__title.data-v-431fd8fd {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #1A1410;
}
.company-auth-page__desc.data-v-431fd8fd {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: #7F7368;
}
.company-auth-page__field.data-v-431fd8fd {
  margin-bottom: 24rpx;
}
.company-auth-page__field-label.data-v-431fd8fd {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1410;
}
.company-auth-page__input.data-v-431fd8fd {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #F5F0EA;
  font-size: 28rpx;
  color: #1A1410;
  width: 100%;
  box-sizing: border-box;
}
.company-auth-page__placeholder.data-v-431fd8fd {
  color: #7F7368;
}
.company-auth-page__success-icon.data-v-431fd8fd {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: rgba(177, 10, 15, 0.1);
  color: #C41E3A;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 96rpx;
  text-align: center;
}
.company-auth-page__success-title.data-v-431fd8fd {
  display: block;
  margin-bottom: 32rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #1A1410;
}
.company-auth-page__info-row.data-v-431fd8fd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #F0F0F0;
  text-align: left;
}
.company-auth-page__label.data-v-431fd8fd {
  font-size: 26rpx;
  color: #7F7368;
}
.company-auth-page__value.data-v-431fd8fd {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1410;
}
.company-auth-page__footer.data-v-431fd8fd {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #E8DDD4;
}
.company-auth-page__submit-btn.data-v-431fd8fd {
  background: #C41E3A;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.company-auth-page__submit-btn.data-v-431fd8fd:active {
  opacity: 0.9;
}