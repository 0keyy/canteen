.address-page.data-v-90a3874e {
  min-height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
}
.address-page__scroll.data-v-90a3874e {
  flex: 1;
  padding-top: 8rpx;
}
.address-page__empty.data-v-90a3874e {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.address-page__empty-emoji.data-v-90a3874e {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}
.address-page__empty-text.data-v-90a3874e {
  font-size: 28rpx;
  color: #999999;
}
.address-page__footer.data-v-90a3874e {
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #EEEEEE;
}
.address-page__add-btn.data-v-90a3874e {
  background: #D00000;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.address-page__add-btn.data-v-90a3874e:active {
  background: #A60000;
}
.address-page__bottom-space.data-v-90a3874e {
  height: 120rpx;
}
.address-card.data-v-90a3874e {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}
.address-card.data-v-90a3874e:active {
  opacity: 0.9;
}
.address-card__top.data-v-90a3874e {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.address-card__name.data-v-90a3874e {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}
.address-card__mobile.data-v-90a3874e {
  font-size: 26rpx;
  color: #666666;
}
.address-card__tag.data-v-90a3874e {
  background: #FFFFFF;
  color: #D00000;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.address-card__detail.data-v-90a3874e {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}
.address-card__actions.data-v-90a3874e {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}
.address-card__action-text.data-v-90a3874e {
  font-size: 24rpx;
  color: #999999;
}
.address-card__action--danger .address-card__action-text.data-v-90a3874e {
  color: #111111;
}