<view wx:if="{{a}}" class="checkout data-v-aaa7ef6e"><scroll-view class="checkout__scroll data-v-aaa7ef6e" scroll-y show-scrollbar="{{false}}"><view class="checkout__section data-v-aaa7ef6e"><view class="checkout__section-title-row data-v-aaa7ef6e"><text class="checkout__section-title data-v-aaa7ef6e">订单信息</text></view><view class="checkout__info-row data-v-aaa7ef6e"><text class="checkout__info-label data-v-aaa7ef6e">就餐方式</text><text class="checkout__info-value data-v-aaa7ef6e">{{b}}</text></view><view wx:if="{{c}}" class="checkout__info-row data-v-aaa7ef6e"><text class="checkout__info-label data-v-aaa7ef6e">联系电话</text><text class="checkout__info-value data-v-aaa7ef6e">{{d}}</text></view><view wx:if="{{e}}" class="checkout__info-row data-v-aaa7ef6e"><text class="checkout__info-label data-v-aaa7ef6e">配送地址</text><text class="checkout__info-value checkout__addr data-v-aaa7ef6e">{{f}}</text></view></view><view class="checkout__section data-v-aaa7ef6e"><view class="checkout__section-title-row data-v-aaa7ef6e"><text class="checkout__section-title data-v-aaa7ef6e">已选菜品</text><text class="checkout__item-count data-v-aaa7ef6e">共{{g}}项</text></view><view class="checkout__items data-v-aaa7ef6e"><view wx:for="{{h}}" wx:for-item="dish" wx:key="d" class="checkout__item data-v-aaa7ef6e"><view class="checkout__item-left data-v-aaa7ef6e"><text class="checkout__item-name data-v-aaa7ef6e">{{dish.a}}</text></view><view class="checkout__item-right data-v-aaa7ef6e"><text class="checkout__item-price data-v-aaa7ef6e">¥{{dish.b}}</text><text class="checkout__item-qty data-v-aaa7ef6e">x{{dish.c}}</text></view></view></view><view class="checkout__summary-row checkout__summary-row--total data-v-aaa7ef6e"><text class="checkout__summary-label-total data-v-aaa7ef6e">合计</text><text class="checkout__summary-total data-v-aaa7ef6e">¥{{i}}</text></view></view><view class="checkout__section data-v-aaa7ef6e"><view class="checkout__section-title-row data-v-aaa7ef6e"><text class="checkout__section-title data-v-aaa7ef6e">优惠券</text><text class="checkout__coupon-link data-v-aaa7ef6e" bindtap="{{j}}">去领券</text></view><view wx:if="{{k}}" class="checkout__coupon-applied data-v-aaa7ef6e"><text class="checkout__coupon-name data-v-aaa7ef6e">✓ {{l}}</text><text class="checkout__coupon-discount data-v-aaa7ef6e">-¥{{m}}</text></view><view wx:else class="checkout__coupon-empty data-v-aaa7ef6e"><text class="checkout__coupon-empty-text data-v-aaa7ef6e">暂无可用优惠券</text></view></view><view class="checkout__section data-v-aaa7ef6e"><pay-method-picker wx:if="{{o}}" class="data-v-aaa7ef6e" u-i="aaa7ef6e-0" bind:__l="__l" bindupdateModelValue="{{n}}" u-p="{{o}}"/></view><view class="checkout__section data-v-aaa7ef6e"><view class="checkout__section-title-row data-v-aaa7ef6e"><text class="checkout__section-title data-v-aaa7ef6e">备注信息</text></view><block wx:if="{{r0}}"><textarea class="checkout__remark data-v-aaa7ef6e" placeholder="添加备注（选填）" placeholder-class="checkout__remark-placeholder" value="{{p}}" bindinput="{{q}}"/></block></view><view class="checkout__bottom-space data-v-aaa7ef6e"></view></scroll-view><view class="checkout__footer safe-area-bottom data-v-aaa7ef6e"><view class="checkout__submit-bar data-v-aaa7ef6e"><view class="checkout__submit-info data-v-aaa7ef6e"><text class="checkout__submit-label data-v-aaa7ef6e">合计</text><text class="checkout__submit-price data-v-aaa7ef6e"> ¥{{r}}</text><text wx:if="{{s}}" class="checkout__submit-saved data-v-aaa7ef6e"> 已优惠¥{{t}}</text></view><view class="checkout__submit-btn data-v-aaa7ef6e" bindtap="{{w}}"><text class="checkout__submit-btn-text data-v-aaa7ef6e">{{v}}</text></view></view></view></view>