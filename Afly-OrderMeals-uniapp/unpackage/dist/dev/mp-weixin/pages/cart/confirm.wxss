.checkout.data-v-aaa7ef6e {
  min-height: 100vh;
  background: #FFFCF8;
  display: flex;
  flex-direction: column;
}
.checkout__scroll.data-v-aaa7ef6e {
  flex: 1;
}
.checkout__section.data-v-aaa7ef6e {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
