.checkout.data-v-aaa7ef6e {
  min-height: 100vh;
  background: #F0EFF5;
  display: flex;
  flex-direction: column;
}
.checkout__header.data-v-aaa7ef6e {
  background: linear-gradient(180deg, #FFECEC 0%, #FFF5F5 100%);
  flex-shrink: 0;
  padding-top: calc(var(--status-bar-height, 88rpx) + 30rpx);
}
.checkout__nav.data-v-aaa7ef6e {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.checkout__back-btn.data-v-aaa7ef6e {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkout__back-icon.data-v-aaa7ef6e {
  font-size: 72rpx;
  color: #333333;
  font-weight: 400;
  line-height: 1;
}
.checkout__logo.data-v-aaa7ef6e {
  height: 300rpx;
  width: 300rpx;
}
.checkout__nav-empty.data-v-aaa7ef6e {
  width: 64rpx;
}
.checkout__scroll.data-v-aaa7ef6e {
  flex: 1;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF5F5 320rpx, #F0EFF5 320rpx, #F0EFF5 100%);
}
.checkout__section--address.data-v-aaa7ef6e {
  background: transparent;
  margin: 0;
  padding: 20rpx 32rpx 24rpx;
  border-radius: 0;
}
.checkout__section--delivery.data-v-aaa7ef6e {
  background: transparent;
  margin: 0;
  padding: 0 32rpx 24rpx;
  border-radius: 0;
}
.checkout__section--dishes.data-v-aaa7ef6e {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
}
.checkout__section--pay.data-v-aaa7ef6e, .checkout__section--remark.data-v-aaa7ef6e {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
.checkout__address-row.data-v-aaa7ef6e {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx;
}
.checkout__address-left.data-v-aaa7ef6e {
  flex: 1;
  min-width: 0;
}
.checkout__address-label.data-v-aaa7ef6e {
  font-size: 34rpx;
  font-weight: 600;
  color: #111111;
  display: block;
}
.checkout__address-detail.data-v-aaa7ef6e {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.checkout__arrow.data-v-aaa7ef6e {
  font-size: 32rpx;
  color: #999999;
  line-height: 1;
  margin-left: 12rpx;
  font-weight: 400;
}
.checkout__section-title-row.data-v-aaa7ef6e {
  margin-bottom: 30rpx;
}
.checkout__section-title.data-v-aaa7ef6e {
  font-size: 28rpx;
  font-weight: 600;
  color: #111111;
}
.checkout__info-row.data-v-aaa7ef6e {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
}
.checkout__info-row--clickable.data-v-aaa7ef6e {
  padding: 4rpx 0;
}
.checkout__info-label.data-v-aaa7ef6e {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.checkout__info-right.data-v-aaa7ef6e {
  display: flex;
  align-items: center;
}
.checkout__info-value.data-v-aaa7ef6e {
  font-size: 26rpx;
  color: #999999;
}
.checkout__info-value--primary.data-v-aaa7ef6e {
  color: #D00000;
  font-weight: 500;
}
.checkout__items.data-v-aaa7ef6e {
  margin-bottom: 24rpx;
}
.checkout__item.data-v-aaa7ef6e {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  position: relative;
}
.checkout__item-left.data-v-aaa7ef6e {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.checkout__item-img.data-v-aaa7ef6e {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  flex-shrink: 0;
}
.checkout__item-info.data-v-aaa7ef6e {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
  justify-content: center;
}
.checkout__item-name.data-v-aaa7ef6e {
  font-size: 28rpx;
  color: #111111;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.checkout__item-qty.data-v-aaa7ef6e {
  font-size: 22rpx;
  color: #999999;
  position: absolute;
  top: 20rpx;
  right: 0;
}
.checkout__item-right.data-v-aaa7ef6e {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
  align-self: flex-end;
  margin-bottom: 4rpx;
}
.checkout__item-price.data-v-aaa7ef6e {
  font-size: 30rpx;
  color: #D00000;
  font-weight: 600;
}
.checkout__amount-section.data-v-aaa7ef6e {
  padding-top: 12rpx;
  border-top: 1rpx solid #F5F5F5;
}
.checkout__amount-row.data-v-aaa7ef6e {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.checkout__amount-row--total.data-v-aaa7ef6e {
  padding-top: 16rpx;
  justify-content: flex-end;
  gap: 8rpx;
}
.checkout__amount-label.data-v-aaa7ef6e {
  font-size: 26rpx;
  color: #666666;
}
.checkout__amount-value.data-v-aaa7ef6e {
  font-size: 26rpx;
  color: #333333;
}
.checkout__amount-value--discount.data-v-aaa7ef6e {
  color: #D00000;
}
.checkout__amount-value--total.data-v-aaa7ef6e {
  font-size: 32rpx;
  font-weight: 700;
  color: #D00000;
}
.checkout__divider.data-v-aaa7ef6e {
  height: 1rpx;
  background: #F5F5F5;
  margin: 8rpx 0;
}
.checkout__remark-input.data-v-aaa7ef6e {
  text-align: right;
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}
.checkout__remark-placeholder.data-v-aaa7ef6e {
  color: #CCCCCC;
}
.checkout__footer.data-v-aaa7ef6e {
  background: #FFFFFF;
  padding: 18rpx 28rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}
.checkout__submit-bar.data-v-aaa7ef6e {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.checkout__submit-info.data-v-aaa7ef6e {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.checkout__submit-label.data-v-aaa7ef6e {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.checkout__submit-price.data-v-aaa7ef6e {
  font-size: 40rpx;
  font-weight: 700;
  color: #D00000;
}
.checkout__submit-btn.data-v-aaa7ef6e {
  background: linear-gradient(135deg, #D00000 0%, #B00000 100%);
  padding: 22rpx 56rpx;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(208, 0, 0, 0.25);
}
.checkout__submit-btn.data-v-aaa7ef6e:active {
  transform: scale(0.97);
  opacity: 0.9;
}
.checkout__submit-btn-text.data-v-aaa7ef6e {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}
.checkout__bottom-space.data-v-aaa7ef6e {
  height: 40rpx;
}
.checkout__pay-picker-mask.data-v-aaa7ef6e {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}
.checkout__pay-picker.data-v-aaa7ef6e {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.checkout__pay-picker-title.data-v-aaa7ef6e {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
  text-align: center;
  margin-bottom: 24rpx;
}
.checkout__pay-options.data-v-aaa7ef6e {
  margin-bottom: 32rpx;
}
.checkout__pay-option.data-v-aaa7ef6e {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.checkout__pay-option.data-v-aaa7ef6e:last-child {
  border-bottom: none;
}
.checkout__pay-option-name.data-v-aaa7ef6e {
  font-size: 28rpx;
  color: #111111;
  font-weight: 500;
}
.checkout__pay-option-check.data-v-aaa7ef6e {
  width: 40rpx;
  height: 40rpx;
  background: #D00000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkout__pay-option-check-icon.data-v-aaa7ef6e {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}
.checkout__pay-picker-close.data-v-aaa7ef6e {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  padding: 20rpx 0;
}