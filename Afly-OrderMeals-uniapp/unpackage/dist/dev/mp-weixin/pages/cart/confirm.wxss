  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
}
.checkout__info-label.data-v-aaa7ef6e {
  font-size: 26rpx;
  color: #666666;
  flex-shrink: 0;
}
.checkout__info-value.data-v-aaa7ef6e {
