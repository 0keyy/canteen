.login-page.data-v-d08ef7d4 {
  min-height: 100vh;
  padding: 0 48rpx 120rpx;
  background: #FFFFFF;
}
.login-page__status-bar.data-v-d08ef7d4 {
  height: env(safe-area-inset-top, 44px);
}
.login-page__header.data-v-d08ef7d4 {
  padding-top: 80rpx;
  margin-bottom: 80rpx;
}
.login-page__title.data-v-d08ef7d4 {
  display: block;
  font-size: 48rpx;
