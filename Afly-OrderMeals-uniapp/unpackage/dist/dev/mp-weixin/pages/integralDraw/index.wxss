}
.draw-box-wrap.data-v-84fa3ceb {
  position: relative;
  z-index: 2;
  background: #a81c1c;
  border-radius: 24rpx;
  padding: 40rpx;
}
.draw-grid.data-v-84fa3ceb {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.draw-item.data-v-84fa3ceb {
  background: #fff;
  border-radius: 18rpx;
  padding: 40rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.1s;
}
.draw-item.active.data-v-84fa3ceb {
  background: #ffe6e6;
  transform: scale(1.03);
}
.draw-item .item-num.data-v-84fa3ceb {
  font-size: 45rpx;
  color: #b82222;
  font-weight: bold;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.draw-item .item-desc.data-v-84fa3ceb {
  font-size: 25rpx;
  color: #666;
}
.center-item.data-v-84fa3ceb {
  background: #fff8f8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  padding: 40rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.center-item.disabled.data-v-84fa3ceb {
