.draw-page.data-v-84fa3ceb {
  min-height: 100vh;
  position: relative;
  padding: calc(60rpx + env(safe-area-inset-top)) 32rpx 40rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #ffd1d1, #fff0f0);
}
.logo-water.data-v-84fa3ceb {
  position: absolute;
  left: 60rpx;
  top: calc(env(safe-area-inset-top) + 100rpx);
  width: 240rpx;
  height: 240rpx;
  opacity: 0.12;
  z-index: 0;
  pointer-events: none;
}
.draw-header.data-v-84fa3ceb {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 240rpx;
  margin-bottom: 100rpx;
}
.draw-header .draw-back.data-v-84fa3ceb {
  position: fixed;
  left: 20rpx;
  top: calc(env(safe-area-inset-top) + 60rpx);
  font-size: 70rpx;
  color: #222;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  z-index: 99;
}
.draw-header .draw-title-wrap.data-v-84fa3ceb {
  flex: 1;
  padding-left: 30rpx;
  padding-top: 10px;
}
.draw-header .draw-title-wrap .draw-title1.data-v-84fa3ceb {
  font-size: 95rpx;
  color: #b82222;
  font-weight: 900;
  display: block;
  letter-spacing: 4rpx;
}
.draw-header .draw-title-wrap .draw-title2.data-v-84fa3ceb {
  font-size: 95rpx;
  color: #b82222;
  font-weight: 900;
  letter-spacing: 6rpx;
}
.draw-header .draw-avatar-wrap.data-v-84fa3ceb {
  position: absolute;
