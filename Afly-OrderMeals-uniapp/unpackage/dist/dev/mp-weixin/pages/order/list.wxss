.orders-page.data-v-456ecf67 {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}
.orders-page__content.data-v-456ecf67 {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}
.orders-page__header-card.data-v-456ecf67 {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.orders-page__store.data-v-456ecf67 {
  display: block;
  font-size: 22rpx;
  color: #666666;
}
.orders-page__title.data-v-456ecf67 {
  display: block;
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: #111111;
}
.orders-page__pending.data-v-456ecf67 {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #D00000 0%, #FF7B7B 100%);
}
.orders-page__pending-title.data-v-456ecf67 {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #FFFFFF;
}
.orders-page__pending-desc.data-v-456ecf67 {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 252, 248, 0.9);
  line-height: 1.5;
}
.orders-page__pending-btn.data-v-456ecf67 {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 16rpx;
  padding: 0 32rpx;
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
}
.orders-page__pending-btn-text.data-v-456ecf67 {
  font-size: 24rpx;
  font-weight: 600;
  color: #111111;
}
.orders-page__pending-arrow.data-v-456ecf67 {
  font-size: 28rpx;
  color: #111111;
  line-height: 1;
}
.orders-page__list.data-v-456ecf67 {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.orders-page__empty.data-v-456ecf67 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}
.orders-page__empty-icon.data-v-456ecf67 {
  width: 160rpx;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.orders-page__empty-icon-inner.data-v-456ecf67 {
  width: 48rpx;
  height: 56rpx;
  border: 4rpx solid #999999;
  border-radius: 6rpx;
}
.orders-page__empty-icon-inner.data-v-456ecf67::before {
  content: "";
  display: block;
  margin: 12rpx auto 0;
  width: 28rpx;
  height: 4rpx;
  background: #999999;
  box-shadow: 0 10rpx 0 #999999, 0 20rpx 0 #999999;
}
.orders-page__empty-title.data-v-456ecf67 {
  font-size: 30rpx;
  color: #666666;
  margin-bottom: 12rpx;
}
.orders-page__empty-desc.data-v-456ecf67 {
  font-size: 24rpx;
  color: #999999;
}
.orders-page__bottom-space.data-v-456ecf67 {
  height: calc(108rpx + env(safe-area-inset-bottom));
}
.order-card.data-v-456ecf67 {
  display: flex;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.order-card.data-v-456ecf67:active {
  opacity: 0.92;
}
.order-card__icon-wrap.data-v-456ecf67 {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(177, 10, 15, 0.1);
  border-radius: 24rpx;
}
.order-card__icon.data-v-456ecf67 {
  width: 36rpx;
  height: 44rpx;
  border: 3rpx solid #D00000;
  border-radius: 4rpx;
}
.order-card__icon.data-v-456ecf67::before {
  content: "";
  display: block;
  margin: 8rpx auto 0;
  width: 22rpx;
