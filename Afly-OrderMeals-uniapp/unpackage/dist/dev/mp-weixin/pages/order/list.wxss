.orders-page.data-v-456ecf67 {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #e9e9e9;
}
.orders-page__navbar.data-v-456ecf67 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}
.orders-page__navbar-left.data-v-456ecf67, .orders-page__navbar-right.data-v-456ecf67 {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.orders-page__navbar-back.data-v-456ecf67 {
  font-size: 64rpx;
  color: #333333;
  line-height: 1;
  font-weight: 300;
}
.orders-page__navbar-search.data-v-456ecf67 {
  font-size: 36rpx;
  color: #333333;
  line-height: 1;
}
.orders-page__navbar-title.data-v-456ecf67 {
  flex: 1;
  text-align: center;
}
.orders-page__navbar-title-text.data-v-456ecf67 {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.orders-page__tabs.data-v-456ecf67 {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid #EEEEEE;
}
.orders-page__tab-item.data-v-456ecf67 {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 20rpx;
  position: relative;
  font-weight: 700;
}
.orders-page__tab-text.data-v-456ecf67 {
  font-size: 28rpx;
  color: #494949;
  line-height: 90rpx;
}
.orders-page__tab-item--active .orders-page__tab-text.data-v-456ecf67 {
  font-weight: 700;
  color: #b31212;
}
.orders-page__content.data-v-456ecf67 {
  flex: 1;
  height: 0;
  padding: 24rpx;
  width: 95vw;
  background: #FFFFFF;
  border-radius: 8rpx;
  margin: 0 auto;
}
.orders-page__list.data-v-456ecf67 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.orders-page__empty.data-v-456ecf67 {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.orders-page__empty-text.data-v-456ecf67 {
  font-size: 26rpx;
  color: #494949;
}
.orders-page__bottom-space.data-v-456ecf67 {
  height: 60rpx;
}
.order-item.data-v-456ecf67 {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order-item__dish.data-v-456ecf67 {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.order-item__dish-img.data-v-456ecf67 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F0F0;
}
.order-item__dish-info.data-v-456ecf67 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 4rpx;
}
.order-item__dish-name.data-v-456ecf67 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.order-item__dish-time.data-v-456ecf67 {
  font-size: 22rpx;
  color: #494949;
}
.order-item__dish-right.data-v-456ecf67 {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  padding-top: 4rpx;
}
.order-item__dish-status.data-v-456ecf67 {
  font-size: 26rpx;
  font-weight: 600;
  color: #b31212;
}
.order-item__dish-status--completed.data-v-456ecf67 {
  color: #494949;
}
.order-item__dish-status--paying.data-v-456ecf67 {
  color: #b31212;
}
.order-item__dish-status--shipping.data-v-456ecf67 {
  color: #FF9800;
}
.order-item__dish-status--delivering.data-v-456ecf67 {
  color: #FF9800;
}
.order-item__dish-status--refund.data-v-456ecf67 {
  color: #CCCCCC;
}
.order-item__dish-price.data-v-456ecf67 {
  font-size: 24rpx;
  color: #494949;
}
.order-item__btn.data-v-456ecf67 {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  margin-top: 4rpx;
}
.order-item__btn--primary.data-v-456ecf67 {
  background: #b31212;
}
.order-item__btn-text.data-v-456ecf67 {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.order-item__more.data-v-456ecf67 {
  padding-top: 8rpx;
  border-top: 1rpx solid #EEEEEE;
  text-align: center;
}
.order-item__more-text.data-v-456ecf67 {
  font-size: 24rpx;
  color: #494949;
}