  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.order-card__amount.data-v-456ecf67 {
  font-size: 32rpx;
  font-weight: 900;
  color: #111111;
}
.order-card__reorder.data-v-456ecf67 {
