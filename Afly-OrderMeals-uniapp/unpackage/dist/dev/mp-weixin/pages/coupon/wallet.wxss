.wallet-page.data-v-0b2f6175 {
  min-height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
}
.wallet-page__header.data-v-0b2f6175 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 24rpx;
  background: #FFFFFF;
  margin-top: 38rpx;
}
.wallet-page__back-btn.data-v-0b2f6175 {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wallet-page__back-icon.data-v-0b2f6175 {
  font-size: 80rpx;
  color: #333333;
  font-weight: 300;
  line-height: 1;
}
.wallet-page__title.data-v-0b2f6175 {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.wallet-page__header-right.data-v-0b2f6175 {
  width: 64rpx;
}
.wallet-page__tabs.data-v-0b2f6175 {
  display: flex;
  background: #FFFFFF;
}
.wallet-page__tab.data-v-0b2f6175 {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #666666;
  position: relative;
  font-weight: 600;
}
.wallet-page__tab--active.data-v-0b2f6175 {
  color: #2e2e2e;
}
.wallet-page__tab--active.data-v-0b2f6175::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #be0000;
  border-radius: 2rpx;
}
.wallet-page__content.data-v-0b2f6175 {
  flex: 1;
  padding: 24rpx;
  background: #e0e0e0;
}
.wallet-page__empty.data-v-0b2f6175 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 32rpx;
}
.wallet-page__empty-icon.data-v-0b2f6175 {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}
.wallet-page__empty-text.data-v-0b2f6175 {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999999;
}
.wallet-page__empty-sub.data-v-0b2f6175 {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #CCCCCC;
}
.wallet-page__list.data-v-0b2f6175 {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.wallet-page__bottom-space.data-v-0b2f6175 {
  height: 40rpx;
}
.wallet-page__footer.data-v-0b2f6175 {
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}
.wallet-page__exchange-btn.data-v-0b2f6175 {
  background: #be0000;
  border-radius: 8rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 16rpx;
}
.wallet-page__exchange-btn.data-v-0b2f6175:active {
  opacity: 0.9;
}
.wallet-page__exchange-text.data-v-0b2f6175 {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}
.coupon-card.data-v-0b2f6175 {
  background: #FFFFFF;
  border-radius: 12rpx;
  display: flex;
  overflow: hidden;
  position: relative;
}
.coupon-card--used.data-v-0b2f6175, .coupon-card--expired.data-v-0b2f6175 {
  opacity: 0.5;
}
.coupon-card__left.data-v-0b2f6175 {
  width: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  position: relative;
}
.coupon-card__left.data-v-0b2f6175::after {
  content: "";
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: repeating-linear-gradient(to bottom, #E8E8E8, #E8E8E8 4rpx, transparent 4rpx, transparent 10rpx);
}
.coupon-card__amount.data-v-0b2f6175 {
  font-size: 48rpx;
  font-weight: 700;
  color: #be0000;
}
.coupon-card__condition.data-v-0b2f6175 {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #be0000;
}
.coupon-card__right.data-v-0b2f6175 {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}
.coupon-card__name.data-v-0b2f6175 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
}
.coupon-card__period.data-v-0b2f6175 {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}
.coupon-card__bottom.data-v-0b2f6175 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 12rpx;
}
.coupon-card__tip.data-v-0b2f6175 {
  font-size: 20rpx;
  color: #CCCCCC;
}
.coupon-card__use-btn.data-v-0b2f6175 {
  background: #be0000;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}
.coupon-card__use-btn.data-v-0b2f6175:active {
  opacity: 0.8;
}
.coupon-card__use-text.data-v-0b2f6175 {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.coupon-card__watermark.data-v-0b2f6175 {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  transform: rotate(-15deg);
}
.coupon-card__watermark text.data-v-0b2f6175 {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(153, 153, 153, 0.4);
}