.recharge-page.data-v-c45a7485 {
  min-height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
}
.recharge-page__header.data-v-c45a7485 {
  background: #FFFFFF;
  padding: 60rpx 32rpx 40rpx;
}
.recharge-page__balance-card.data-v-c45a7485 {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #111111;
}
.recharge-page__balance-icon.data-v-c45a7485 {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.recharge-page__balance-image.data-v-c45a7485 {
  width: 100rpx;
  height: 100rpx;
}
.recharge-page__balance-label.data-v-c45a7485 {
  font-size: 28rpx;
  color: #1b1b1b;
  margin-bottom: 16rpx;
}
.recharge-page__balance-value.data-v-c45a7485 {
  font-size: 64rpx;
  font-weight: 700;
  color: #111111;
  line-height: 1;
}
.recharge-page__scroll.data-v-c45a7485 {
  flex: 1;
  margin-top: 100rpx;
}
.recharge-page__section.data-v-c45a7485 {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
}
.recharge-page__section-title.data-v-c45a7485 {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}
.recharge-page__amount-grid.data-v-c45a7485 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.recharge-page__amount-item.data-v-c45a7485 {
  width: calc((100% - 50rpx) / 3);
  height: 120rpx;
  border-radius: 12rpx;
  background: #9e9e9e;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recharge-page__amount-item--active.data-v-c45a7485 {
  background: #b20300;
}
.recharge-page__amount-item--active .recharge-page__amount-text.data-v-c45a7485 {
  color: #FFFFFF;
}
.recharge-page__amount-item.data-v-c45a7485:active {
  opacity: 0.8;
}
.recharge-page__amount-text.data-v-c45a7485 {
  font-size: 28rpx;
  color: #ededed;
  font-weight: 700;
}
.recharge-page__custom-input.data-v-c45a7485 {
  width: 100%;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.recharge-page__amount-item--custom.data-v-c45a7485 {
  position: relative;
}
.recharge-page__bottom-space.data-v-c45a7485 {
  height: 40rpx;
}
.recharge-page__footer.data-v-c45a7485 {
  background: #FFFFFF;
  padding: 24rpx 32rpx 20rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}
.recharge-page__recharge-btn.data-v-c45a7485 {
  background: linear-gradient(135deg, #b20300 0%, #A01731 100%);
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recharge-page__recharge-btn.data-v-c45a7485:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.recharge-page__recharge-btn-text.data-v-c45a7485 {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.recharge-page__record-link.data-v-c45a7485 {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}
.recharge-page__record-text.data-v-c45a7485 {
  font-size: 26rpx;
  color: #999999;
}