/* 底部自定义 Tab 栏占位高度 */
/* ===== 兼容旧变量 ===== */
.dept-picker.data-v-a752faee {
  /* 微信小程序 scroll-view 必须指定高度 */
}
.dept-picker__trigger.data-v-a752faee {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #F5F5F5;
  font-size: 28rpx;
  color: #111111;
}
.dept-picker__placeholder.data-v-a752faee {
  color: #666666;
}
.dept-picker__arrow.data-v-a752faee {
  font-size: 36rpx;
  color: #666666;
  line-height: 1;
}
.dept-picker__popup.data-v-a752faee {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
}
.dept-picker__mask.data-v-a752faee {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.dept-picker__panel.data-v-a752faee {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.dept-picker__header.data-v-a752faee {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}
.dept-picker__title.data-v-a752faee {
  font-size: 32rpx;
  font-weight: bold;
  color: #111111;
}
.dept-picker__close.data-v-a752faee {
  font-size: 44rpx;
  line-height: 1;
  color: #666666;
  padding: 0 8rpx;
}
.dept-picker__scroll.data-v-a752faee {
  height: 55vh;
  max-height: 800rpx;
}
.dept-picker__row.data-v-a752faee {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding-right: 32rpx;
  border-bottom: 1rpx solid #F8F8F8;
}
.dept-picker__row--active.data-v-a752faee {
  background: rgba(177, 10, 15, 0.06);
}
.dept-picker__row--active .dept-picker__name.data-v-a752faee {
  color: #D00000;
  font-weight: 600;
}
.dept-picker__expand.data-v-a752faee {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.dept-picker__expand--placeholder.data-v-a752faee {
  opacity: 0;
}
.dept-picker__expand-icon.data-v-a752faee {
  font-size: 32rpx;
  color: #666666;
  transform: rotate(0deg);
  transition: transform 0.2s;
}
.dept-picker__expand-icon--open.data-v-a752faee {
  transform: rotate(90deg);
}
.dept-picker__name.data-v-a752faee {
  flex: 1;
  font-size: 28rpx;
  color: #111111;
  line-height: 1.4;
}
.dept-picker__check.data-v-a752faee {
  font-size: 28rpx;
  color: #D00000;
  font-weight: bold;
  margin-left: 12rpx;
}
.dept-picker__empty.data-v-a752faee {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
}