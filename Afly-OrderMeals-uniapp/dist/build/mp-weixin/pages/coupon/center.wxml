<view class="coupon-center data-v-a9d9dbb2"><view class="coupon-center__header data-v-a9d9dbb2"><view class="coupon-center__header-left data-v-a9d9dbb2"><text class="coupon-center__title data-v-a9d9dbb2">领券中心</text><text class="coupon-center__sub data-v-a9d9dbb2">领取优惠券，下单更优惠</text></view><view class="coupon-center__header-right data-v-a9d9dbb2"><image src="{{a}}" mode="" class="coupon-center__header-image data-v-a9d9dbb2"></image></view></view><view wx:if="{{b}}" class="coupon-center__status data-v-a9d9dbb2"><text class="coupon-center__status-text data-v-a9d9dbb2">加载中...</text></view><view wx:elif="{{c}}" class="coupon-center__status data-v-a9d9dbb2"><text class="coupon-center__status-text data-v-a9d9dbb2">暂无可领取的优惠券</text></view><view wx:else class="coupon-center__list data-v-a9d9dbb2"><view wx:for="{{d}}" wx:for-item="coupon" wx:key="q" class="{{['coupon-card', 'data-v-a9d9dbb2', coupon.r && 'coupon-card--claimed']}}" bindtap="{{coupon.s}}"><view class="coupon-card__left data-v-a9d9dbb2"><text class="coupon-card__amount data-v-a9d9dbb2">¥{{coupon.a}}</text><text class="coupon-card__condition data-v-a9d9dbb2"><block wx:if="{{coupon.b}}"> 满{{coupon.c}}元可用 </block><block wx:elif="{{coupon.d}}"> 夜间券 · {{coupon.e}}-{{coupon.f}}</block><block wx:elif="{{coupon.g}}"> 到店核销 </block><block wx:else> 无门槛 </block></text></view><view class="coupon-card__right data-v-a9d9dbb2"><text class="coupon-card__name data-v-a9d9dbb2">{{coupon.h}}</text><text class="coupon-card__type-tag data-v-a9d9dbb2">{{coupon.i}}</text><text wx:if="{{coupon.j}}" class="coupon-card__time data-v-a9d9dbb2">{{coupon.k}} ~ {{coupon.l}}</text><text wx:if="{{coupon.m}}" class="coupon-card__stock data-v-a9d9dbb2"> 剩余 {{coupon.n}} / {{coupon.o}}</text><view wx:if="{{coupon.p}}" class="coupon-card__btn coupon-card__btn--done data-v-a9d9dbb2"><text class="data-v-a9d9dbb2">已领取</text></view><view wx:else class="coupon-card__btn data-v-a9d9dbb2"><text class="data-v-a9d9dbb2">立即领取</text></view></view></view></view></view>