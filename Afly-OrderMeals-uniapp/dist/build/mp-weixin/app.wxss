page{background-color:#fffcf8;font-family:PingFang SC,HarmonyOS Sans SC,Noto Sans CJK SC,Microsoft YaHei,HarmonyOS Sans,sans-serif;font-size:28rpx;color:#1a1410;-webkit-font-smoothing:antialiased;-webkit-tap-highlight-color:transparent}view,text,image,scroll-view,swiper{box-sizing:border-box}.price{color:#c41e3a;font-weight:900;font-size:36rpx}.safe-area-bottom{padding-bottom:env(safe-area-inset-bottom)}.btn-primary{background:#c41e3a;color:#fff;border-radius:999rpx;font-weight:600;text-align:center;transition:background .15s ease}.btn-primary:active{background:#8e1526}.btn-primary--disabled{background:#ccc!important;color:#fff}.btn-secondary{background:#fff;color:#7f7368;border:1rpx solid #E8DDD4;border-radius:999rpx;font-weight:500;text-align:center}.btn-secondary:active{background:#f5f0ea}.page-tabbar-spacer{height:calc(108rpx + env(safe-area-inset-bottom));flex-shrink:0}.app-tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:1000;width:100%;height:calc(108rpx + env(safe-area-inset-bottom));min-height:100rpx;padding:8rpx 16rpx env(safe-area-inset-bottom);display:flex;background:#fffcf8;border-top:1rpx solid #E8DDD4;box-sizing:border-box}.app-tab-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;min-height:88rpx;transition:transform .15s ease}.app-tab-item:active{transform:scale(.92)}.app-tab-item:not(.app-tab-item--active) .app-tab-icon{filter:grayscale(100%);opacity:.5}.app-tab-icon-wrap{display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx}.app-tab-icon{width:44rpx;height:44rpx;display:block}.app-tab-text{font-size:22rpx;font-weight:600;line-height:1.2}
page::after{position:fixed;content:'';left:-1000px;top:-1000px;-webkit-animation:shadow-preload .1s;-webkit-animation-delay:3s;animation:shadow-preload .1s;animation-delay:3s}@-webkit-keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}@keyframes shadow-preload{0%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}100%{background-image:url(https://cdn1.dcloud.net.cn/img/shadow-grey.png)}}page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}